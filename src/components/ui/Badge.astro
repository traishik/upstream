---
interface Props { tone?: 'default' | 'accent' | 'live' | 'new' }
const { tone = 'default' } = Astro.props;
const tones = {
  default: 'border-hairline text-muted',
  accent: 'border-accent/50 text-accent',
  live: 'border-live/40 text-live',
  new: 'border-accent-fill bg-accent-fill text-on-accent',
};
---
<span class={`meta inline-flex h-6 items-center rounded-full border px-2.5 !text-[0.625rem] ${tones[tone]}`}><slot /></span>
