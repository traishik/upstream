---
interface Props { live: number; newToday: number; refreshedAgo: string; stale?: boolean }
const { live, newToday, refreshedAgo, stale = false } = Astro.props;
const fmt = new Intl.NumberFormat('en-US');
---
<p class="meta flex flex-wrap items-center gap-x-4 gap-y-2 text-ink" aria-live="polite">
  <span class="inline-flex items-center gap-2">
    <span class="relative inline-flex size-2" aria-hidden="true">
      <span class="pulse absolute inline-flex size-full rounded-full bg-live opacity-60"></span>
      <span class="relative inline-flex size-2 rounded-full bg-live"></span>
    </span>
    {fmt.format(live)} live roles
  </span>
  <span class="text-hairline-strong" aria-hidden="true">/</span>
  <span>{fmt.format(newToday)} new today</span>
  <span class="text-hairline-strong" aria-hidden="true">/</span>
  <span class="text-muted">Refreshed {refreshedAgo}</span>
</p>
{stale && <p class="meta mt-2 text-accent">Data may be stale</p>}
<style>
  .pulse { animation: pulse 2.4s var(--ease-out) infinite; }
  @keyframes pulse { 0% { transform: scale(1); opacity: .6 } 80%, 100% { transform: scale(2.4); opacity: 0 } }
</style>
