---
import Base from '@/layouts/Base.astro';
---
<Base title="Not found" noindex>
  <section class="mx-auto flex max-w-xl flex-col items-center gap-4 px-4 py-32 text-center">
    <span class="rule-accent inline-block" aria-hidden="true"></span>
    <h1 class="text-[length:var(--t-h1)]">This page took a different path</h1>
    <p class="text-muted">If you followed a link to a role, it has probably closed. We take roles down as soon as companies do.</p>
    <a href="/jobs" class="link text-sm">Browse live roles →</a>
  </section>
</Base>
