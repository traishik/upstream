---
import Base from '@/layouts/Base.astro';
import InsiderPrompt from '@/components/ui/InsiderPrompt.astro';
import InsiderCard from '@/components/ui/InsiderCard.astro';
import { copy } from '@content/copy';
import { sharedAgo, visibleNotes } from '@/lib/insiders';
import { loadManifest } from '@/lib/manifest';
const names = Object.fromEntries(loadManifest().companies.map((c) => [c.slug, c.name]));
const notes = visibleNotes();
const byCompany = new Map<string, typeof notes>();
for (const n of notes) (byCompany.get(n.company) ?? byCompany.set(n.company, []).get(n.company)!).push(n);
---
<Base title="Inside Track" description="Tips and referrals from people who work at the companies we follow.">
  <section class="mx-auto max-w-6xl px-4 pb-24 pt-16 sm:px-8">
    <p class="meta flex items-center gap-4 text-accent"><span class="rule-accent inline-block"></span>{copy.insiders.eyebrow}</p>
    <h1 class="mt-6 text-[length:var(--t-h1)]">Advice from the inside</h1>
    <p class="mt-4 max-w-2xl text-muted">People who work at these companies share what they wish they'd known, and sometimes a referral link. Every note is reviewed before it appears.</p>
    <div class="mt-12"><InsiderPrompt /></div>
    {notes.length === 0 ? (
      <div class="mt-16 max-w-xl">
        <h2 class="text-[length:var(--t-h2)]">The first notes are on their way</h2>
        <p class="mt-4 text-muted">Inside Track has just opened. If you work at one of the companies we follow, you could be the first to light the way for someone.</p>
      </div>
    ) : (
      [...byCompany.entries()].map(([slug, list]) => (
        <div class="mt-16">
          <h2 class="text-[length:var(--t-h3)]"><a class="hover:text-accent" href={`/companies/${slug}/`}>{copy.insiders.sectionTitle(names[slug] ?? slug)}</a></h2>
          <div class="mt-4">{list.map((n) => <InsiderCard id={n.id} name={n.name} role={n.role} tenure={n.tenure} tip={n.tip} referralUrl={n.referralUrl} referralNote={n.referralNote} sharedAgo={sharedAgo(n.createdAt)} />)}</div>
        </div>
      ))
    )}
    <p class="mt-16 max-w-2xl text-xs leading-5 text-muted">{copy.insiders.disclaimer}</p>
  </section>
</Base>
