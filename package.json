    "@fontsource/cormorant-garamond": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.12",
    "minisearch": "^7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.2",
